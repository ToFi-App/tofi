DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
ACCESS_TOKEN_ENCRYPTION_KEY=
PORT=3000
PLAID_REDIRECT_URI=

# Durable request and error logging. Set on the Vercel project only — running locally with a
# token set mixes local traffic into the production dataset, so the server refuses to start.
AXIOM_TOKEN=
AXIOM_DATASET=tofi-backend


# Alpaca market data (free plan: 200 calls/min, shared by every user). Historical prices are
# relayed to the device and never stored server-side.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
