{
  "expo": {
    "name": "ToFi",
    "slug": "ledge",
    "scheme": "ledge",
    "version": "1.0.3",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAF8",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qihongw08.ledge",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:ledge-oauth-88792.netlify.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ledge.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-updates",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.466182310065-t4qljvrapvh4fq8ime2hffnb002ku6hl"
        }
      ],
      "expo-notifications",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.4"
          }
        }
      ],
      "./plugins/withFinanceKitEntitlement",
      [
        "expo-finance-kit/plugin/build/index.js",
        {
          "usageDescription": "ToFi reads your Apple Card, Apple Cash, and Savings transactions and balances on this iPhone so they appear in your net worth, budgets, and spending categories. This data stays on your device.",
          "enableBackgroundDelivery": false
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/96613371-347c-470f-9fee-122140c33376"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96613371-347c-470f-9fee-122140c33376"
      }
    },
    "owner": "qihongw08"
  }
}
